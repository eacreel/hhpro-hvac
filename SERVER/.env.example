# HHpro backend settings.
# Copy this file to .env (same folder) and fill in SESSION_SECRET.
# .env is git-ignored and never leaves the server.

# Port the backend listens on. Must match the Cloudflare Tunnel route
# for api.hhpro-hvac.com (localhost:8787).
PORT=8787

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Site origins allowed to call the API from a browser, comma separated.
ALLOWED_ORIGINS=https://hhpro-hvac.com

# Site owner. Recorded as "added by" for imported users and shown as the
# contact for new locations or permissions.
SUPER_ADMIN=eric.creel@hoffman-hoffman.com

# Where backups are written. Default: the Users\backups folder next to the
# data. Point this at a network share to keep copies off this machine, e.g.
#   BACKUP_DIR=\\\\fileserver\\backups\\hhpro
# BACKUP_DIR=

# The weekly site backup leaves out ASSETS (about 3 GB of CAD and PDFs,
# all of which are also in the GitHub repo). Set to true to include it.
# BACKUP_SITE_INCLUDE_ASSETS=false
